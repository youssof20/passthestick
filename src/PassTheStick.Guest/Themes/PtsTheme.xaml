<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keep in sync with Host theme -->
    <Color x:Key="PtsBgPrimary">#0F0F0F</Color>
    <Color x:Key="PtsBgSecondary">#1A1A1A</Color>
    <Color x:Key="PtsBgTertiary">#252525</Color>
    <Color x:Key="PtsBorder">#2E2E2E</Color>
    <Color x:Key="PtsTextPrimary">#F0F0F0</Color>
    <Color x:Key="PtsTextSecondary">#888888</Color>
    <Color x:Key="PtsAccentGreen">#00C896</Color>
    <Color x:Key="PtsAccentOrange">#FF6B35</Color>
    <Color x:Key="PtsAccentRed">#FF4444</Color>
    <Color x:Key="PtsAccentBlue">#4A9EFF</Color>

    <SolidColorBrush x:Key="PtsBrushBgPrimary" Color="{StaticResource PtsBgPrimary}"/>
    <SolidColorBrush x:Key="PtsBrushBgSecondary" Color="{StaticResource PtsBgSecondary}"/>
    <SolidColorBrush x:Key="PtsBrushBgTertiary" Color="{StaticResource PtsBgTertiary}"/>
    <SolidColorBrush x:Key="PtsBrushBorder" Color="{StaticResource PtsBorder}"/>
    <SolidColorBrush x:Key="PtsBrushTextPrimary" Color="{StaticResource PtsTextPrimary}"/>
    <SolidColorBrush x:Key="PtsBrushTextSecondary" Color="{StaticResource PtsTextSecondary}"/>
    <SolidColorBrush x:Key="PtsBrushGreen" Color="{StaticResource PtsAccentGreen}"/>
    <SolidColorBrush x:Key="PtsBrushOrange" Color="{StaticResource PtsAccentOrange}"/>
    <SolidColorBrush x:Key="PtsBrushRed" Color="{StaticResource PtsAccentRed}"/>
    <SolidColorBrush x:Key="PtsBrushBlue" Color="{StaticResource PtsAccentBlue}"/>

    <FontFamily x:Key="PtsFont">Segoe UI</FontFamily>
    <FontFamily x:Key="PtsMonoFont">Consolas</FontFamily>

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource PtsBrushBgPrimary}"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="PtsLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{StaticResource PtsBrushBgTertiary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtsBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="{StaticResource PtsBrushBgTertiary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtsBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource PtsBrushTextPrimary}"/>
    </Style>
</ResourceDictionary>

