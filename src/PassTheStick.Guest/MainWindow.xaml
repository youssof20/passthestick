<Window x:Class="PassTheStick.Guest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassTheStick (guest)"
        Icon="passthestick.ico"
        Height="220" Width="360"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <Border x:Name="HaveStickBanner"
                Background="#222"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="HaveStickTitle"
                           Text="YOU HAVE THE STICK"
                           Foreground="#FFF"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="HaveStickSubtitle"
                           Text="Your keyboard is live — switch to the game's screenshare and play."
                           Foreground="#BBB"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Room code:" Margin="0,0,0,4"/>
        <TextBox x:Name="RoomCodeBox" MaxLength="4" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <TextBlock Text="Your name:" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" MaxLength="32" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <Button x:Name="JoinButton" Content="Join" Click="JoinButton_Click" Width="100" HorizontalAlignment="Left"/>
        <TextBlock x:Name="StickStatusText" Text="Not connected" Foreground="#666" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="LatencyText" Text="Latency: —" Foreground="#666" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusText" Text="" Foreground="#666" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
