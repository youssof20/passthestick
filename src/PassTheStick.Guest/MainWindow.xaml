<Window x:Class="PassTheStick.Guest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassTheStick (guest)"
        Icon="passthestick.ico"
        Height="520" Width="380"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="PassTheStick" FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Join state -->
        <Border x:Name="JoinPanel"
                Grid.Row="1"
                Background="{StaticResource PtsBrushBgSecondary}"
                BorderBrush="{StaticResource PtsBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel>
                <TextBlock Text="ROOM CODE" Style="{StaticResource PtsLabel}" Margin="0,0,0,6"/>
                <TextBox x:Name="RoomCodeBox"
                         MaxLength="4"
                         HorizontalContentAlignment="Center"
                         FontFamily="{StaticResource PtsMonoFont}"
                         FontSize="22"
                         Height="44"
                         Margin="0,0,0,12"/>

                <TextBlock Text="YOUR NAME" Style="{StaticResource PtsLabel}" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox"
                         MaxLength="32"
                         Height="38"
                         Margin="0,0,0,16"/>

                <Button x:Name="JoinButton"
                        Content="Join session"
                        Click="JoinButton_Click"
                        Height="44"/>

                <TextBlock x:Name="JoinStatusText"
                           Text=""
                           Foreground="{StaticResource PtsBrushTextSecondary}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Waiting state -->
        <Border x:Name="WaitingPanel"
                Grid.Row="1"
                Background="{StaticResource PtsBrushBgSecondary}"
                BorderBrush="{StaticResource PtsBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="WaitingHeader"
                           Text="Room: ----  •  Connected (—ms)"
                           Foreground="{StaticResource PtsBrushTextSecondary}"
                           Margin="0,0,0,12"/>

                <Border Background="{StaticResource PtsBrushBgTertiary}"
                        BorderBrush="{StaticResource PtsBrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="WaitingTitle" Text="Waiting for your turn" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WaitingSubtitle" Text="Host is playing right now" Foreground="{StaticResource PtsBrushTextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Players in session" Style="{StaticResource PtsLabel}" Margin="0,0,0,6"/>
                <ListBox x:Name="GuestPlayersList" Height="180" DisplayMemberPath="Name"/>
            </StackPanel>
        </Border>

        <!-- Active state -->
        <Border x:Name="ActivePanel"
                Grid.Row="1"
                Background="{StaticResource PtsBrushBgSecondary}"
                BorderBrush="{StaticResource PtsBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="ActiveBody"
                        Background="{StaticResource PtsBrushBgSecondary}"
                        BorderBrush="{StaticResource PtsBrushOrange}"
                        BorderThickness="4,0,0,0"
                        Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YOU HAVE THE STICK" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Text="Your keyboard is live now." Foreground="{StaticResource PtsBrushTextSecondary}" Margin="0,10,0,0" TextAlignment="Center"/>
                        <TextBlock Text="Switch to the screen share and start playing!" Foreground="{StaticResource PtsBrushTextSecondary}" Margin="0,4,0,0" TextAlignment="Center"/>
                        <TextBlock x:Name="ActiveStatusLine"
                                   Text="Latency: —ms  •  Connected"
                                   Foreground="{StaticResource PtsBrushTextSecondary}"
                                   Margin="0,16,0,0"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <WrapPanel Grid.Row="1" Margin="16,0,16,16">
                    <Border x:Name="G_Echo_W" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="W"/></Border>
                    <Border x:Name="G_Echo_A" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="A"/></Border>
                    <Border x:Name="G_Echo_S" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="S"/></Border>
                    <Border x:Name="G_Echo_D" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="D"/></Border>
                    <Border x:Name="G_Echo_Space" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="Space"/></Border>
                    <Border x:Name="G_Echo_Up" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="↑"/></Border>
                    <Border x:Name="G_Echo_Down" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="↓"/></Border>
                    <Border x:Name="G_Echo_Left" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="←"/></Border>
                    <Border x:Name="G_Echo_Right" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="→"/></Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Footer status (minimal) -->
        <TextBlock Grid.Row="2"
                   x:Name="FooterText"
                   Text=""
                   Foreground="{StaticResource PtsBrushTextSecondary}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
