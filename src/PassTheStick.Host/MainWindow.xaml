<Window x:Class="PassTheStick.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassTheStick (host)"
        Icon="passthestick.ico"
        Height="340" Width="380"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock x:Name="RoomCodeLabel" Text="Room code: —" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBlock Text="Select your game window:" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="RefreshWindowsButton" Content="Refresh" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0"
                    Click="RefreshWindowsButton_Click"/>
            <ComboBox x:Name="WindowPicker"
                      Height="26"
                      IsEditable="False"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Hwnd"/>
        </DockPanel>

        <Button x:Name="PinSelectedButton" Content="Pin selected window" Click="PinSelectedButton_Click" Margin="0,0,0,4"/>
        <TextBlock x:Name="PinnedGameLabel" Text="Game: (not pinned)" Foreground="#666" FontSize="12" Margin="0,0,0,8"/>

        <TextBlock Text="Pass stick to:" Margin="0,8,0,4"/>
        <ListBox x:Name="PlayersList"
                 Height="100"
                 Margin="0,0,0,8"
                 DisplayMemberPath="Name"
                 SelectionChanged="PlayersList_SelectionChanged"
                 MouseDoubleClick="PlayersList_MouseDoubleClick"/>

        <Expander Header="Input log (debug)" IsExpanded="False" Margin="0,0,0,8"
                  Expanded="InputLogExpander_Expanded"
                  Collapsed="InputLogExpander_Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <ComboBox x:Name="LogLevelCombo"
                              Width="110"
                              Height="22"
                              Margin="0,0,6,0"
                              SelectionChanged="LogLevelCombo_SelectionChanged">
                        <ComboBoxItem Content="Verbose"/>
                        <ComboBoxItem Content="Info"/>
                        <ComboBoxItem Content="Warning"/>
                        <ComboBoxItem Content="Error"/>
                    </ComboBox>
                    <Button Content="Copy logs" Click="CopyInputLogs_Click" Width="80" Height="22" Margin="0,0,6,0"/>
                    <Button Content="Clear" Click="ClearLog_Click" Width="50" Height="22"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="InputLogText"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Disabled"/>
                </ScrollViewer>
            </Grid>
        </Expander>

        <DockPanel LastChildFill="True">
            <Button x:Name="TakeStickBackButton" Content="Take stick back" Width="120" DockPanel.Dock="Left"
                    Click="TakeStickBackButton_Click" Margin="0,0,8,0"/>
            <Button x:Name="PassStickButton" Content="Pass stick to selected" Click="PassStickButton_Click" IsEnabled="False"/>
        </DockPanel>

        <DockPanel Margin="0,12,0,0">
            <Ellipse x:Name="RelayDot" Width="10" Height="10" Fill="#C33" Margin="0,3,8,0"/>
            <TextBlock x:Name="RelayStatusText"
                       Text="Not connected — click to view connection status"
                       Foreground="#666"
                       FontSize="12"
                       Cursor="Hand"
                       MouseLeftButtonUp="RelayStatusText_MouseLeftButtonUp"
                       TextWrapping="Wrap"/>
        </DockPanel>

        <TextBlock x:Name="InjectionStatsText"
                   Text="Injected: 0 | Failed: 0 | Dropped: 0"
                   Foreground="#666"
                   FontSize="12"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>

        <WrapPanel x:Name="KeyEchoPanel" Margin="0,6,0,0">
            <Border x:Name="Echo_W" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="W"/></Border>
            <Border x:Name="Echo_A" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="A"/></Border>
            <Border x:Name="Echo_S" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="S"/></Border>
            <Border x:Name="Echo_D" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="D"/></Border>

            <Border x:Name="Echo_Space" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="Space"/></Border>
            <Border x:Name="Echo_Enter" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="Enter"/></Border>
            <Border x:Name="Echo_Esc" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="Esc"/></Border>

            <Border x:Name="Echo_Up" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="↑"/></Border>
            <Border x:Name="Echo_Down" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="↓"/></Border>
            <Border x:Name="Echo_Left" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="←"/></Border>
            <Border x:Name="Echo_Right" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Text="→"/></Border>
        </WrapPanel>

        <TextBlock x:Name="StatusText" Text="" Foreground="#666" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
