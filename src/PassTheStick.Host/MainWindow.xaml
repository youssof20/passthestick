<Window x:Class="PassTheStick.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassTheStick (host)"
        Icon="passthestick.ico"
        Height="340" Width="380"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock x:Name="RoomCodeLabel" Text="Room code: —" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBlock Text="Select your game window:" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="RefreshWindowsButton" Content="Refresh" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0"
                    Click="RefreshWindowsButton_Click"/>
            <ComboBox x:Name="WindowPicker"
                      Height="26"
                      IsEditable="False"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Hwnd"/>
        </DockPanel>

        <Button x:Name="PinSelectedButton" Content="Pin selected window" Click="PinSelectedButton_Click" Margin="0,0,0,4"/>
        <TextBlock x:Name="PinnedGameLabel" Text="Game: (not pinned)" Foreground="#666" FontSize="12" Margin="0,0,0,8"/>

        <TextBlock Text="Pass stick to:" Margin="0,8,0,4"/>
        <ListBox x:Name="PlayersList"
                 Height="100"
                 Margin="0,0,0,8"
                 DisplayMemberPath="Name"
                 SelectionChanged="PlayersList_SelectionChanged"
                 MouseDoubleClick="PlayersList_MouseDoubleClick"/>

        <DockPanel LastChildFill="True">
            <Button x:Name="TakeStickBackButton" Content="Take stick back" Width="120" DockPanel.Dock="Left"
                    Click="TakeStickBackButton_Click" Margin="0,0,8,0"/>
            <Button x:Name="PassStickButton" Content="Pass stick to selected" Click="PassStickButton_Click" IsEnabled="False"/>
        </DockPanel>

        <DockPanel Margin="0,12,0,0">
            <Ellipse x:Name="RelayDot" Width="10" Height="10" Fill="#C33" Margin="0,3,8,0"/>
            <TextBlock x:Name="RelayStatusText"
                       Text="Not connected — click to view connection status"
                       Foreground="#666"
                       FontSize="12"
                       Cursor="Hand"
                       MouseLeftButtonUp="RelayStatusText_MouseLeftButtonUp"
                       TextWrapping="Wrap"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" Text="" Foreground="#666" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
