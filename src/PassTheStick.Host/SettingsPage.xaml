<UserControl x:Class="PassTheStick.Host.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PtsBrushBgPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PtsBrushTextPrimary}"
                       Margin="0,0,0,16"/>

            <Border Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CONNECTION" Style="{StaticResource PtsLabel}"/>
                    <TextBox x:Name="SettingsRelayUrlText"
                             Margin="0,8,0,4"
                             ToolTip="Override relay WebSocket URL (e.g. wss://… or ws://localhost:8080). Empty = default."/>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource PtsBrushTextSecondary}"
                               Text="Applied on next connect. Pin your game again or restart if already in a session."/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="HOTKEYS" Style="{StaticResource PtsLabel}"/>
                    <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PtsBrushTextPrimary}"
                               Text="Pass stick: Ctrl+Shift+Right&#10;Take back: Ctrl+Shift+Left"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="BEHAVIOR" Style="{StaticResource PtsLabel}"/>
                    <CheckBox x:Name="SettingsSoundsCheck"
                              Margin="0,10,0,0"
                              Foreground="{StaticResource PtsBrushTextPrimary}"
                              Content="Stick sounds (Windows system sounds)"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource PtsLabel}"/>
                    <TextBlock x:Name="AboutVersionText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PtsBrushTextSecondary}"/>
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PtsBrushTextSecondary}"
                               Text="Open source · MIT License"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="View on GitHub"
                                Padding="10,6"
                                Click="GitHub_Click"/>
                        <Button Content="Check for updates"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Click="CheckUpdates_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="Save settings"
                    HorizontalAlignment="Stretch"
                    Padding="10,12"
                    Margin="0,8,0,24"
                    Background="{StaticResource PtsBrushGreen}"
                    Foreground="#0F0F0F"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="SaveSettings_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
