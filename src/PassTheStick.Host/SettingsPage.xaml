<UserControl x:Class="PassTheStick.Host.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PtsBrushBgPrimary}">
    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="20"
                   FontWeight="Light"
                   Foreground="{StaticResource PtsBrushTextPrimary}"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <Border Background="{StaticResource PtsBrushBgSecondary}"
                        BorderBrush="{StaticResource PtsBrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="CONNECTION" Style="{StaticResource PtsLabel}"/>
                        <TextBox x:Name="SettingsRelayUrlText"
                                 Margin="0,6,0,4"
                                 LostFocus="SettingsRelayUrlText_LostFocus"
                                 ToolTip="Override relay WebSocket URL (e.g. wss://… or ws://localhost:8080). Empty = default."/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Test connection"
                                    Style="{StaticResource PtsOutlinedButton}"
                                    FontSize="11"
                                    Padding="10,5"
                                    Click="TestRelayConnection_Click"/>
                            <TextBlock x:Name="RelayTestResult"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PtsBrushTextBody}"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{StaticResource PtsBrushTextLabel}"
                                   Margin="0,6,0,0"
                                   Text="Relay URL saves when you leave the field or start a session. Test uses a 5s timeout."/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PtsBrushBgSecondary}"
                        BorderBrush="{StaticResource PtsBrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="HOTKEYS" Style="{StaticResource PtsLabel}"/>
                        <DockPanel Margin="0,6,0,3" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource PtsBrushTextLabel}" MinWidth="110" VerticalAlignment="Center" FontSize="12">
                                Pass stick</TextBlock>
                            <TextBlock x:Name="PassHotkeyLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Foreground="{StaticResource PtsBrushTextPrimary}" MinWidth="140" FontSize="12"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Hyperlink Click="ChangePassHotkey_Click" Foreground="{StaticResource PtsBrushGreen}">Change</Hyperlink>
                            </TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource PtsBrushTextLabel}" MinWidth="110" VerticalAlignment="Center" FontSize="12">
                                Take stick back</TextBlock>
                            <TextBlock x:Name="TakeBackHotkeyLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Foreground="{StaticResource PtsBrushTextPrimary}" MinWidth="140" FontSize="12"/>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Hyperlink Click="ChangeTakeBackHotkey_Click" Foreground="{StaticResource PtsBrushGreen}">Change</Hyperlink>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <Border Background="{StaticResource PtsBrushBgSecondary}"
                        BorderBrush="{StaticResource PtsBrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="BEHAVIOR" Style="{StaticResource PtsLabel}"/>
                        <DockPanel Margin="0,6,0,0" LastChildFill="True">
                            <ToggleButton x:Name="AutoFocusGameCheck"
                                          DockPanel.Dock="Right"
                                          Style="{StaticResource PtsToggle}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          Checked="BehaviorCheck_Changed"
                                          Unchecked="BehaviorCheck_Changed"/>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource PtsBrushTextBody}"
                                       Text="Auto-focus game when stick is received"/>
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0" LastChildFill="True">
                            <ToggleButton x:Name="ReleaseHeldKeysCheck"
                                          DockPanel.Dock="Right"
                                          Style="{StaticResource PtsToggle}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          Checked="BehaviorCheck_Changed"
                                          Unchecked="BehaviorCheck_Changed"/>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource PtsBrushTextBody}"
                                       Text="Release held keys on stick pass"/>
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0" LastChildFill="True">
                            <ToggleButton x:Name="ShowOverlayCheck"
                                          DockPanel.Dock="Right"
                                          Style="{StaticResource PtsToggle}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          Checked="BehaviorCheck_Changed"
                                          Unchecked="BehaviorCheck_Changed"/>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource PtsBrushTextBody}"
                                       Text="Show overlay during sessions"/>
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0" LastChildFill="True">
                            <ToggleButton x:Name="SettingsSoundsCheck"
                                          DockPanel.Dock="Right"
                                          Style="{StaticResource PtsToggle}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          Checked="BehaviorCheck_Changed"
                                          Unchecked="BehaviorCheck_Changed"/>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource PtsBrushTextBody}"
                                       Text="Enable pass/receive sounds"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PtsBrushBgSecondary}"
                        BorderBrush="{StaticResource PtsBrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ABOUT" Style="{StaticResource PtsLabel}"/>
                        <TextBlock x:Name="AboutVersionText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource PtsBrushTextBody}"/>
                        <TextBlock Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource PtsBrushTextLabel}"
                                   Text="Open source · MIT License"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="View on GitHub"
                                    Style="{StaticResource PtsSecondaryButton}"
                                    FontSize="11"
                                    Padding="10,5"
                                    Click="GitHub_Click"/>
                            <Button Content="Check for updates"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PtsSecondaryButton}"
                                    FontSize="11"
                                    Padding="10,5"
                                    Click="CheckUpdates_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
