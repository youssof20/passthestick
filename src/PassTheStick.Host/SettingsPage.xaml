<UserControl x:Class="PassTheStick.Host.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PtsBrushBgPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PtsBrushTextPrimary}"
                       Margin="0,0,0,16"/>

            <Border Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CONNECTION" Style="{StaticResource PtsLabel}"/>
                    <TextBox x:Name="SettingsRelayUrlText"
                             Margin="0,8,0,4"
                             LostFocus="SettingsRelayUrlText_LostFocus"
                             ToolTip="Override relay WebSocket URL (e.g. wss://… or ws://localhost:8080). Empty = default."/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Test connection"
                                Padding="10,6"
                                Click="TestRelayConnection_Click"/>
                        <TextBlock x:Name="RelayTestResult"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PtsBrushTextSecondary}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource PtsBrushTextSecondary}"
                               Margin="0,8,0,0"
                               Text="Relay URL is saved when you leave the field or start a session. Test uses the URL above (5s timeout)."/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="HOTKEYS" Style="{StaticResource PtsLabel}"/>
                    <DockPanel Margin="0,8,0,4">
                        <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource PtsBrushTextSecondary}" MinWidth="140">
                            Pass stick</TextBlock>
                        <TextBlock x:Name="PassHotkeyLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="{StaticResource PtsBrushTextPrimary}" MinWidth="200"/>
                        <TextBlock HorizontalAlignment="Right">
                            <Hyperlink Click="ChangePassHotkey_Click" Foreground="{StaticResource PtsBrushGreen}">Change</Hyperlink>
                        </TextBlock>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource PtsBrushTextSecondary}" MinWidth="140">
                            Take stick back</TextBlock>
                        <TextBlock x:Name="TakeBackHotkeyLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="{StaticResource PtsBrushTextPrimary}" MinWidth="200"/>
                        <TextBlock HorizontalAlignment="Right">
                            <Hyperlink Click="ChangeTakeBackHotkey_Click" Foreground="{StaticResource PtsBrushGreen}">Change</Hyperlink>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="BEHAVIOR" Style="{StaticResource PtsLabel}"/>
                    <CheckBox x:Name="AutoFocusGameCheck"
                              Margin="0,10,0,0"
                              Foreground="{StaticResource PtsBrushTextPrimary}"
                              Content="Auto-focus game window when stick is received"
                              Checked="BehaviorCheck_Changed"
                              Unchecked="BehaviorCheck_Changed"/>
                    <CheckBox x:Name="ReleaseHeldKeysCheck"
                              Margin="0,8,0,0"
                              Foreground="{StaticResource PtsBrushTextPrimary}"
                              Content="Release held keys on stick pass"
                              Checked="BehaviorCheck_Changed"
                              Unchecked="BehaviorCheck_Changed"/>
                    <CheckBox x:Name="ShowOverlayCheck"
                              Margin="0,8,0,0"
                              Foreground="{StaticResource PtsBrushTextPrimary}"
                              Content="Show overlay during sessions"
                              Checked="BehaviorCheck_Changed"
                              Unchecked="BehaviorCheck_Changed"/>
                    <CheckBox x:Name="SettingsSoundsCheck"
                              Margin="0,8,0,0"
                              Foreground="{StaticResource PtsBrushTextPrimary}"
                              Content="Enable sounds (Windows system sounds on pass/receive)"
                              Checked="BehaviorCheck_Changed"
                              Unchecked="BehaviorCheck_Changed"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource PtsLabel}"/>
                    <TextBlock x:Name="AboutVersionText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PtsBrushTextSecondary}"/>
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PtsBrushTextSecondary}"
                               Text="Open source · MIT License"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="View on GitHub"
                                Padding="10,6"
                                Click="GitHub_Click"/>
                        <Button Content="Check for updates"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Click="CheckUpdates_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
