<Window x:Class="PassTheStick.Host.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Icon="passthestick.ico"
        Width="200" Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OverlayWindow_MouseLeftButtonDown">
    <Border x:Name="PillBorder" CornerRadius="18" Background="#E6000000" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock x:Name="PlayerNameText" Text="Host" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock x:Name="BannerText" Text="" Foreground="#CCFFFFFF" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
