<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens (canonical colors) -->
    <Color x:Key="PtsColorPrimary">#00C896</Color>
    <Color x:Key="PtsColorPrimaryHover">#00A87E</Color>
    <Color x:Key="PtsColorPrimaryPressed">#008F6A</Color>
    <Color x:Key="PtsColorPrimaryOutlineHoverTint">#1500C896</Color>
    <Color x:Key="PtsColorSecondary">#FF6B35</Color>
    <Color x:Key="PtsColorTertiary">#FF9467</Color>
    <Color x:Key="PtsColorTertiaryPressTint">#20FF9467</Color>
    <Color x:Key="PtsColorComboItemHoverTint">#26FF9467</Color>
    <Color x:Key="PtsColorBg">#0A0A0A</Color>
    <Color x:Key="PtsColorCard">#181818</Color>
    <Color x:Key="PtsColorCardHover">#222222</Color>
    <Color x:Key="PtsColorBorder">#2A2A2A</Color>
    <Color x:Key="PtsColorBorderHover">#444444</Color>
    <Color x:Key="PtsColorTextHeadline">#E0E0E0</Color>
    <Color x:Key="PtsColorTextBody">#AAAAAA</Color>
    <Color x:Key="PtsColorTextLabel">#666666</Color>
    <Color x:Key="PtsColorTextMuted">#444444</Color>
    <Color x:Key="PtsColorNavInactive">#777777</Color>
    <Color x:Key="PtsColorNavInactiveHover">#999999</Color>
    <Color x:Key="PtsColorControlHover">#2E2E2E</Color>
    <Color x:Key="PtsColorListRowHover">#252525</Color>
    <Color x:Key="PtsColorHoverForeground">#F0F0F0</Color>
    <Color x:Key="PtsColorToggleTrackOff">#333333</Color>
    <Color x:Key="PtsAccentRed">#FF4444</Color>
    <Color x:Key="PtsAccentBlue">#4A9EFF</Color>
    <Color x:Key="PtsBannerHostBg">#0D1F1A</Color>
    <Color x:Key="PtsBannerGuestBg">#1F1208</Color>

    <SolidColorBrush x:Key="PtsBrushPrimary" Color="{StaticResource PtsColorPrimary}"/>
    <SolidColorBrush x:Key="PtsBrushSecondary" Color="{StaticResource PtsColorSecondary}"/>
    <SolidColorBrush x:Key="PtsBrushTertiary" Color="{StaticResource PtsColorTertiary}"/>
    <SolidColorBrush x:Key="PtsBrushTertiaryPressTint" Color="{StaticResource PtsColorTertiaryPressTint}"/>
    <SolidColorBrush x:Key="PtsBrushComboItemHover" Color="{StaticResource PtsColorComboItemHoverTint}"/>
    <SolidColorBrush x:Key="PtsBrushPrimaryOutlineHover" Color="{StaticResource PtsColorPrimaryOutlineHoverTint}"/>
    <SolidColorBrush x:Key="PtsBrushBorderHover" Color="{StaticResource PtsColorBorderHover}"/>

    <SolidColorBrush x:Key="PtsBrushBgPrimary" Color="{StaticResource PtsColorBg}"/>
    <SolidColorBrush x:Key="PtsBrushBgSecondary" Color="{StaticResource PtsColorCard}"/>
    <SolidColorBrush x:Key="PtsBrushBgTertiary" Color="{StaticResource PtsColorCardHover}"/>
    <SolidColorBrush x:Key="PtsBrushBorder" Color="{StaticResource PtsColorBorder}"/>
    <SolidColorBrush x:Key="PtsBrushTextPrimary" Color="{StaticResource PtsColorTextHeadline}"/>
    <SolidColorBrush x:Key="PtsBrushTextBody" Color="{StaticResource PtsColorTextBody}"/>
    <SolidColorBrush x:Key="PtsBrushTextLabel" Color="{StaticResource PtsColorTextLabel}"/>
    <SolidColorBrush x:Key="PtsBrushTextMuted" Color="{StaticResource PtsColorTextMuted}"/>
    <!-- Body / supporting copy (paragraphs, descriptions) -->
    <SolidColorBrush x:Key="PtsBrushTextSecondary" Color="{StaticResource PtsColorTextBody}"/>

    <SolidColorBrush x:Key="PtsBrushLabelSection" Color="{StaticResource PtsColorTextLabel}"/>
    <SolidColorBrush x:Key="PtsBrushGreen" Color="{StaticResource PtsColorPrimary}"/>
    <SolidColorBrush x:Key="PtsBrushOrange" Color="{StaticResource PtsColorSecondary}"/>
    <SolidColorBrush x:Key="PtsBrushRed" Color="{StaticResource PtsAccentRed}"/>
    <SolidColorBrush x:Key="PtsBrushBlue" Color="{StaticResource PtsAccentBlue}"/>
    <SolidColorBrush x:Key="PtsBrushFooter" Color="{StaticResource PtsColorTextMuted}"/>
    <SolidColorBrush x:Key="PtsBrushBannerHost" Color="{StaticResource PtsBannerHostBg}"/>
    <SolidColorBrush x:Key="PtsBrushBannerGuest" Color="{StaticResource PtsBannerGuestBg}"/>

    <!-- Shell sidebar nav (ShellWindow.xaml / code-behind TryFindResource) -->
    <SolidColorBrush x:Key="PtsBrushNavInactive" Color="{StaticResource PtsColorNavInactive}"/>
    <SolidColorBrush x:Key="PtsBrushNavInactiveHover" Color="{StaticResource PtsColorNavInactiveHover}"/>
    <SolidColorBrush x:Key="PtsBrushNavActive" Color="{StaticResource PtsColorPrimary}"/>
    <SolidColorBrush x:Key="PtsBrushNavHover" Color="{StaticResource PtsColorNavInactiveHover}"/>

    <!-- Used by button/list/combo styles (were referenced but not defined) -->
    <SolidColorBrush x:Key="PtsBrushControlHover" Color="{StaticResource PtsColorControlHover}"/>
    <SolidColorBrush x:Key="PtsBrushHoverForeground" Color="{StaticResource PtsColorHoverForeground}"/>
    <SolidColorBrush x:Key="PtsBrushListRowHover" Color="{StaticResource PtsColorListRowHover}"/>

    <!-- Optional aliases (same tokens as PtsBrushText*); for legacy keys / tooling -->
    <SolidColorBrush x:Key="PtsTextHeadline" Color="{StaticResource PtsColorTextHeadline}"/>
    <SolidColorBrush x:Key="PtsTextBody" Color="{StaticResource PtsColorTextBody}"/>
    <SolidColorBrush x:Key="PtsTextLabel" Color="{StaticResource PtsColorTextLabel}"/>
    <SolidColorBrush x:Key="PtsTextMuted" Color="{StaticResource PtsColorTextMuted}"/>

    <FontFamily x:Key="PtsFont">Segoe UI</FontFamily>
    <FontFamily x:Key="PtsMonoFont">Consolas</FontFamily>

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource PtsBrushBgPrimary}"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="{x:Type Hyperlink}">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="PtsSectionLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextLabel}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="PtsLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtsSectionLabel}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="PtsPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PtsBrushPrimary}"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushBgPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource PtsColorPrimaryHover}"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource PtsColorPrimaryPressed}"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtsSecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtsBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PtsBrushControlHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PtsBrushBorderHover}"/>
                <Setter Property="Foreground" Value="{StaticResource PtsBrushHoverForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtsOutlinedButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtsBrushPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PtsBrushPrimaryOutlineHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtsToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Track"
                            Width="40" Height="22"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource PtsColorToggleTrackOff}"/>
                        </Border.Background>
                        <Grid>
                            <Ellipse x:Name="Thumb"
                                     Width="16" Height="16"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource PtsBrushPrimary}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{StaticResource PtsBrushBgTertiary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtsBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PtsBrushControlHover}"/>
                <Setter Property="Foreground" Value="{StaticResource PtsBrushHoverForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="{StaticResource PtsBrushBgTertiary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtsBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource PtsBrushTextPrimary}"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="{StaticResource PtsBrushBgSecondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtsBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource PtsFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="10,4,6,4"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="1"
                                           Text="▾"
                                           Foreground="{StaticResource PtsBrushTextLabel}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource PtsBrushBgSecondary}"
                                    BorderBrush="{StaticResource PtsBrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Margin="0"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleButton" Property="Background" Value="{StaticResource PtsBrushControlHover}"/>
                            <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource PtsBrushPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PtsBrushListRowHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource PtsBrushHoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PtsBrushBgTertiary}"/>
                            <Setter Property="Foreground" Value="{StaticResource PtsBrushGreen}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource PtsBrushBgSecondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PtsBrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PtsBrushBgTertiary}"/>
                            <Setter Property="Foreground" Value="{StaticResource PtsBrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PtsBrushListRowHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource PtsBrushHoverForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{StaticResource PtsBrushBgSecondary}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>
