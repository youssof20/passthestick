<Window x:Class="PassTheStick.Host.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassTheStick"
        Icon="pack://application:,,,/appicon.png"
        Width="920"
        Height="700"
        MinWidth="920"
        MaxWidth="920"
        MinHeight="700"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource PtsBrushBgPrimary}"
        WindowStartupLocation="CenterScreen">
    <Border BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#0A0A0A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False" Margin="12,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Image Width="24" Height="24" Source="pack://application:,,,/appicon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PassTheStick"
                                   FontSize="13"
                                   FontWeight="Light"
                                   Foreground="{StaticResource PtsBrushTextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="MinimizeButton"
                                Content="&#x2014;"
                                Width="40"
                                Height="28"
                                Padding="0"
                                FontSize="14"
                                Foreground="#C0C0C0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize"/>
                        <Button x:Name="CloseButton"
                                Content="&#x2715;"
                                Width="40"
                                Height="28"
                                Padding="0"
                                FontSize="12"
                                Foreground="#C0C0C0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                ToolTip="Close"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Update banner -->
            <Border x:Name="UpdateBanner"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#1A2640"
                    BorderBrush="#4A9EFF"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="UpdateBannerText"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="#B8D4FF"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <Button DockPanel.Dock="Right"
                            Content="Download"
                            Margin="12,0,0,0"
                            Style="{StaticResource PtsPrimaryButton}"
                            Click="UpdateDownload_Click"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#0A0A0A"
                        BorderBrush="{StaticResource PtsBrushBorder}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <StackPanel Margin="0,12,0,0" VerticalAlignment="Top">
                            <Border x:Name="HostNavBorder"
                                    BorderThickness="2,0,0,0"
                                    BorderBrush="Transparent"
                                    Background="Transparent">
                                <Button x:Name="NavHost"
                                        Tag="host"
                                        Click="NavButton_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,10"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="&#x1F3AE;"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource PtsBrushPrimary}"/>
                                        <TextBlock Text="HOST"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource PtsBrushPrimary}"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border x:Name="GuestNavBorder"
                                    BorderThickness="2,0,0,0"
                                    BorderBrush="Transparent"
                                    Background="Transparent">
                                <Button x:Name="NavGuest"
                                        Tag="guest"
                                        Click="NavButton_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,10"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="&#x1F464;"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource PtsBrushTextMuted}"/>
                                        <TextBlock Text="GUEST"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource PtsBrushTextMuted}"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border x:Name="SettingsNavBorder"
                                    BorderThickness="2,0,0,0"
                                    BorderBrush="Transparent"
                                    Background="Transparent">
                                <Button x:Name="NavSettings"
                                        Tag="settings"
                                        Click="NavButton_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,10"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="&#x2699;"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource PtsBrushTextMuted}"/>
                                        <TextBlock Text="SETTINGS"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource PtsBrushTextMuted}"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SidebarVersionText"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"
                                   FontSize="10"
                                   Foreground="{StaticResource PtsBrushTextMuted}"
                                   Text="v—"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource PtsBrushBgPrimary}" Padding="16">
                    <ContentControl x:Name="MainContent"/>
                </Border>
            </Grid>

            <!-- First-launch onboarding -->
            <Border x:Name="OnboardingOverlay"
                    Grid.RowSpan="3"
                    Background="#99000000"
                    Visibility="Collapsed"
                    Panel.ZIndex="200">
                <Border Background="{StaticResource PtsBrushBgSecondary}"
                        CornerRadius="16"
                        Padding="24"
                        Width="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource PtsBrushBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Image Width="32" Height="32" Source="pack://application:,,,/appicon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="PassTheStick"
                                       FontSize="18"
                                       FontWeight="Light"
                                       Foreground="{StaticResource PtsBrushTextPrimary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="OnboardingTitle"
                                   FontSize="20"
                                   FontWeight="Light"
                                   Foreground="{StaticResource PtsBrushTextPrimary}"
                                   Text="Welcome"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="OnboardingBody"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PtsBrushTextBody}"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextAlignment="Center"/>
                        <Button x:Name="OnboardingPrimaryButton"
                                Content="Next"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PtsPrimaryButton}"
                                Click="OnboardingPrimary_Click"/>
                        <Button Content="Skip"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PtsSecondaryButton}"
                                Click="OnboardingSkip_Click"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
