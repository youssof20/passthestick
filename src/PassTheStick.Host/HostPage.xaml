<UserControl x:Class="PassTheStick.Host.HostPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PassTheStick.Host"
        Background="{StaticResource PtsBrushBgPrimary}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:PlayerRowViewModel}">
            <ContentControl Content="{Binding}">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="RowBorder"
                                Padding="6,4"
                                Background="Transparent"
                                CornerRadius="6">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="PassHoverBtn"
                                        DockPanel.Dock="Right"
                                        Content="Pass"
                                        Style="{StaticResource PtsOutlinedButton}"
                                        FontSize="11"
                                        Padding="8,4"
                                        Margin="8,0,0,0"
                                        Opacity="0"
                                        Cursor="Hand"
                                        Click="PlayerRowPass_Click"/>
                                <Border Width="4" CornerRadius="2" Margin="0,2,10,2" DockPanel.Dock="Left" VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PtsBrushGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4"
                                            Background="{StaticResource PtsBrushBgTertiary}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="ACTIVE" FontSize="10" Foreground="{StaticResource PtsBrushGreen}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="PassHoverBtn" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + relay pill -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
                <Image Width="18" Height="18" Source="pack://application:,,,/appicon.png" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="PassTheStick" FontSize="14" FontWeight="Light" Foreground="{StaticResource PtsBrushTextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border x:Name="RelayStatusPill"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    MaxWidth="220"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    Padding="10,5"
                    Background="{StaticResource PtsBrushBgSecondary}"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RelayDot" Width="8" Height="8" Fill="{StaticResource PtsBrushRed}" Margin="0,1,8,0"/>
                    <TextBlock x:Name="RelayStatusText"
                               Text="Offline"
                               Foreground="{StaticResource PtsBrushTextPrimary}"
                               FontSize="12"
                               Cursor="Hand"
                               MouseLeftButtonUp="RelayStatusText_MouseLeftButtonUp"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- ROOM CODE — compact row -->
        <Border Grid.Row="1"
                Background="{StaticResource PtsBrushBgSecondary}"
                BorderBrush="{StaticResource PtsBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ROOM CODE"
                               FontSize="10"
                               FontWeight="Normal"
                               Foreground="{StaticResource PtsBrushTextLabel}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="RoomCodeText"
                               Text="—"
                               FontFamily="{StaticResource PtsMonoFont}"
                               FontSize="32"
                               FontWeight="Light"
                               Foreground="{StaticResource PtsBrushTextPrimary}"
                               CharacterSpacing="150"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Copy code"
                        Style="{StaticResource PtsSecondaryButton}"
                        FontSize="11"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Click="CopyRoomCode_Click"/>
            </Grid>
        </Border>

        <!-- GAME -->
        <Border Grid.Row="2"
                Background="{StaticResource PtsBrushBgSecondary}"
                BorderBrush="{StaticResource PtsBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GAME" Style="{StaticResource PtsSectionLabel}" Margin="0,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshWindowsButton"
                            Grid.Column="1"
                            Content="↻ Refresh"
                            Width="70"
                            Height="24"
                            Style="{StaticResource PtsSecondaryButton}"
                            FontSize="11"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="RefreshWindowsButton_Click"/>
                </Grid>

                <TextBlock x:Name="PinnedGameLabel"
                           Grid.Row="1"
                           Text="No game selected — pin a window to start"
                           Foreground="{StaticResource PtsBrushTextLabel}"
                           FontSize="12"
                           Margin="0,8,0,8"
                           TextWrapping="Wrap"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="WindowPicker"
                              Grid.Column="0"
                              Height="34"
                              Margin="0,0,8,0"
                              IsEditable="False"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Hwnd"/>
                    <Button x:Name="PinSelectedButton"
                            Grid.Column="1"
                            Content="Pin selected window"
                            Width="160"
                            Height="34"
                            Style="{StaticResource PtsPrimaryButton}"
                            FontSize="12"
                            Padding="8,4"
                            Click="PinSelectedButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- PLAYERS card (fills remaining space) -->
        <Border Grid.Row="3"
                Background="{StaticResource PtsBrushBgSecondary}"
                BorderBrush="{StaticResource PtsBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PLAYERS" Style="{StaticResource PtsSectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Background="{StaticResource PtsBrushBgTertiary}"
                            CornerRadius="10"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="PlayersCountBadge"
                                   Text="0 connected"
                                   FontSize="11"
                                   Foreground="{StaticResource PtsBrushTextLabel}"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="StatusText"
                           Grid.Row="1"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource PtsBrushTextMuted}"
                           FontSize="11"
                           Margin="0,0,0,8"
                           Text="Select and pin your game window to start a session."/>

                <Grid Grid.Row="2" MinHeight="120">
                    <ListBox x:Name="PlayersList"
                             Panel.ZIndex="0"
                             VerticalAlignment="Stretch"
                             Background="Transparent"
                             BorderThickness="1"
                             BorderBrush="{StaticResource PtsBrushBorder}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="PlayersList_MouseDoubleClick"/>
                    <StackPanel x:Name="PlayersEmptyState"
                                Panel.ZIndex="1"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="16">
                        <TextBlock Text="No guests connected"
                                   FontSize="13"
                                   Foreground="#444444"
                                   HorizontalAlignment="Center"
                                   FontWeight="Normal"/>
                        <TextBlock Text="Share your room code to invite friends"
                                   FontSize="11"
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <WrapPanel x:Name="KeyEchoPanel" Grid.Row="3" Margin="0,10,0,0">
                    <Border x:Name="Echo_W" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="W"/></Border>
                    <Border x:Name="Echo_A" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="A"/></Border>
                    <Border x:Name="Echo_S" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="S"/></Border>
                    <Border x:Name="Echo_D" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="D"/></Border>
                    <Border x:Name="Echo_Space" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="Space"/></Border>
                    <Border x:Name="Echo_Enter" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="Enter"/></Border>
                    <Border x:Name="Echo_Esc" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="Esc"/></Border>
                    <Border x:Name="Echo_Up" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="↑"/></Border>
                    <Border x:Name="Echo_Down" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="↓"/></Border>
                    <Border x:Name="Echo_Left" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="←"/></Border>
                    <Border x:Name="Echo_Right" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextLabel}" Text="→"/></Border>
                </WrapPanel>

                <Expander x:Name="DebugExpander" Grid.Row="4" Header="Debug" IsExpanded="False" Margin="0,8,0,0"
                          Expanded="InputLogExpander_Expanded"
                          Collapsed="InputLogExpander_Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                            <ComboBox x:Name="LogLevelCombo"
                                      Width="110"
                                      Height="28"
                                      Margin="0,0,8,0"
                                      SelectionChanged="LogLevelCombo_SelectionChanged">
                                <ComboBoxItem Content="Verbose"/>
                                <ComboBoxItem Content="Info"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Error"/>
                            </ComboBox>
                            <Button Content="Copy logs" Style="{StaticResource PtsSecondaryButton}" FontSize="11" Click="CopyInputLogs_Click" Padding="10,6" Margin="0,0,8,0"/>
                            <Button Content="Clear" Style="{StaticResource PtsSecondaryButton}" FontSize="11" Click="ClearLog_Click" Padding="10,6"/>
                        </StackPanel>
                        <TextBox x:Name="InputLogText"
                                 Grid.Row="1"
                                 Height="120"
                                 Background="{StaticResource PtsBrushBgTertiary}"
                                 BorderBrush="{StaticResource PtsBrushBorder}"
                                 BorderThickness="1"
                                 FontFamily="{StaticResource PtsMonoFont}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 AcceptsReturn="True"/>
                    </Grid>
                </Expander>
            </Grid>
        </Border>

        <!-- Active banner: left accent + body -->
        <Grid Grid.Row="4" Margin="0,0,0,6" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ActiveBannerPulseStrip"
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource PtsBrushGreen}"/>
            <Border x:Name="ActiveBanner"
                    Grid.Column="1"
                    Background="{StaticResource PtsBrushBannerHost}"
                    Padding="10,8"
                    ClipToBounds="True"
                    CornerRadius="0,8,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ActiveBannerTitle"
                                   Text="🎮  Your keyboard is live"
                                   Foreground="{StaticResource PtsBrushTextPrimary}"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ActiveBannerSubtitle"
                                   Text="Input scoped to pinned game window"
                                   Foreground="{StaticResource PtsBrushTextLabel}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="TakeStickBackButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Content="Take it back"
                            Style="{StaticResource PtsOutlinedButton}"
                            FontSize="12"
                            Visibility="Collapsed"
                            Click="TakeStickBackButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="5"
                Height="38"
                Background="#0A0A0A"
                BorderBrush="#1E1E1E"
                BorderThickness="0,1,0,0"
                Padding="16,0"
                Margin="0,4,0,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Right"
                        Content="Debug"
                        Style="{StaticResource PtsSecondaryButton}"
                        Padding="10,5"
                        FontSize="11"
                        VerticalAlignment="Center"
                        Click="OpenDebugPanel_Click"/>
                <TextBlock x:Name="InjectionStatsText"
                           Text="Injected: 0 | Failed: 0 | Dropped: 0"
                           Foreground="{StaticResource PtsBrushTextMuted}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
