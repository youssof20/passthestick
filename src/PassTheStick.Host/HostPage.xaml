<UserControl x:Class="PassTheStick.Host.HostPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PassTheStick.Host"
        Background="{StaticResource PtsBrushBgPrimary}">
    <UserControl.Resources>
        <!-- ControlTemplate.Triggers allows Setter TargetName; Style.Triggers does not. -->
        <DataTemplate DataType="{x:Type local:PlayerRowViewModel}">
            <ContentControl Content="{Binding}">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="RowBorder"
                                Padding="6,4"
                                Background="Transparent"
                                CornerRadius="6">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="PassHoverBtn"
                                        DockPanel.Dock="Right"
                                        Content="Pass"
                                        Padding="10,4"
                                        Margin="8,0,0,0"
                                        Opacity="0"
                                        Click="PlayerRowPass_Click"/>
                                <Border Width="4" CornerRadius="2" Margin="0,2,10,2" DockPanel.Dock="Left" VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PtsBrushGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4"
                                            Background="{StaticResource PtsBrushBgTertiary}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="ACTIVE" FontSize="10" Foreground="{StaticResource PtsBrushGreen}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="PassHoverBtn" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Main content -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <Image Width="18" Height="18" Source="pack://application:,,,/appicon.png" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PassTheStick" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        MaxWidth="130"
                        HorizontalAlignment="Right"
                        CornerRadius="20"
                        BorderBrush="{StaticResource PtsBrushBorder}"
                        BorderThickness="1"
                        Padding="10,6"
                        Background="{StaticResource PtsBrushBgSecondary}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="RelayDot" Width="8" Height="8" Fill="{StaticResource PtsBrushRed}" Margin="0,1,8,0"/>
                        <TextBlock x:Name="RelayStatusText"
                                   Text="Offline"
                                   Foreground="{StaticResource PtsBrushTextPrimary}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="RelayStatusText_MouseLeftButtonUp"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ROOM CODE" Style="{StaticResource PtsLabel}"/>
                    <TextBlock x:Name="RoomCodeText"
                               Grid.Row="1"
                               Text="—"
                               FontFamily="{StaticResource PtsMonoFont}"
                               FontSize="36"
                               FontWeight="Bold"
                               Margin="0,6,0,8"/>
                    <Button Grid.Row="2"
                            Content="Copy code"
                            HorizontalAlignment="Left"
                            Padding="10,6"
                            Click="CopyRoomCode_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource PtsBrushBgSecondary}"
                    BorderBrush="{StaticResource PtsBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="GAME" Style="{StaticResource PtsLabel}"/>
                        <Button x:Name="RefreshWindowsButton"
                                DockPanel.Dock="Right"
                                Content="Refresh"
                                Padding="10,6"
                                Click="RefreshWindowsButton_Click"/>
                    </DockPanel>

                    <TextBlock x:Name="PinnedGameLabel"
                               Grid.Row="1"
                               Text="No game selected — pin a window to start"
                               Foreground="{StaticResource PtsBrushTextSecondary}"
                               Margin="0,10,0,10"/>

                    <DockPanel Grid.Row="2">
                        <ComboBox x:Name="WindowPicker"
                                  Height="34"
                                  IsEditable="False"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Hwnd"/>
                        <Button x:Name="PinSelectedButton"
                                DockPanel.Dock="Right"
                                Content="Pin selected window"
                                Margin="8,0,0,0"
                                Click="PinSelectedButton_Click"/>
                    </DockPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="PLAYERS" Style="{StaticResource PtsLabel}" VerticalAlignment="Center"/>
                        <Button x:Name="PassStickButton"
                                DockPanel.Dock="Right"
                                Content="Pass to selected"
                                Padding="10,6"
                                Click="PassStickButton_Click"
                                IsEnabled="False"/>
                    </DockPanel>

                    <TextBlock x:Name="StatusText"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PtsBrushTextSecondary}"
                               FontSize="12"
                               Margin="0,0,0,10"
                               Text="Select and pin your game window to start a session."/>

                    <ListBox x:Name="PlayersList"
                             Margin="0,0,0,12"
                             MinHeight="100"
                             BorderBrush="{StaticResource PtsBrushBorder}"
                             BorderThickness="1"
                             Background="{StaticResource PtsBrushBgTertiary}"
                             SelectionChanged="PlayersList_SelectionChanged"
                             MouseDoubleClick="PlayersList_MouseDoubleClick"/>

                    <Border x:Name="ActiveBanner"
                            Background="{StaticResource PtsBrushBgSecondary}"
                            BorderBrush="{StaticResource PtsBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock x:Name="ActiveBannerTitle" Text="YOU HAVE THE STICK" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveBannerSubtitle" Text="Your keyboard is live" Foreground="{StaticResource PtsBrushTextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="TakeStickBackButton"
                                    DockPanel.Dock="Right"
                                    Content="Take it back"
                                    Padding="10,6"
                                    Click="TakeStickBackButton_Click"/>
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="InjectionStatsText"
                               Text="Injected: 0 | Failed: 0 | Dropped: 0"
                               Foreground="{StaticResource PtsBrushTextSecondary}"
                               FontSize="12"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"/>

                    <WrapPanel x:Name="KeyEchoPanel" Margin="0,0,0,12">
                        <Border x:Name="Echo_W" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="W"/></Border>
                        <Border x:Name="Echo_A" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="A"/></Border>
                        <Border x:Name="Echo_S" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="S"/></Border>
                        <Border x:Name="Echo_D" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="D"/></Border>
                        <Border x:Name="Echo_Space" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="Space"/></Border>
                        <Border x:Name="Echo_Enter" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="Enter"/></Border>
                        <Border x:Name="Echo_Esc" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="Esc"/></Border>
                        <Border x:Name="Echo_Up" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="↑"/></Border>
                        <Border x:Name="Echo_Down" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="↓"/></Border>
                        <Border x:Name="Echo_Left" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="←"/></Border>
                        <Border x:Name="Echo_Right" Background="{StaticResource PtsBrushBgTertiary}" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6"><TextBlock Foreground="{StaticResource PtsBrushTextSecondary}" Text="→"/></Border>
                    </WrapPanel>

                    <Expander x:Name="DebugExpander" Header="Debug" IsExpanded="False" Margin="0,0,0,8"
                              Expanded="InputLogExpander_Expanded"
                              Collapsed="InputLogExpander_Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="140"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                <ComboBox x:Name="LogLevelCombo"
                                          Width="110"
                                          Height="28"
                                          Margin="0,0,8,0"
                                          SelectionChanged="LogLevelCombo_SelectionChanged">
                                    <ComboBoxItem Content="Verbose"/>
                                    <ComboBoxItem Content="Info"/>
                                    <ComboBoxItem Content="Warning"/>
                                    <ComboBoxItem Content="Error"/>
                                </ComboBox>
                                <Button Content="Copy logs" Click="CopyInputLogs_Click" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="Clear" Click="ClearLog_Click" Padding="10,6"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="InputLogText"
                                         Background="{StaticResource PtsBrushBgTertiary}"
                                         BorderBrush="{StaticResource PtsBrushBorder}"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource PtsMonoFont}"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Disabled"/>
                            </ScrollViewer>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="4" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Debug" Padding="10,6" Click="OpenDebugPanel_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
