<Window x:Class="PassTheStick.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassTheStick"
        Icon="..\..\assets\passthestick.ico"
        Height="220" Width="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Run as host or guest?" FontSize="16" Margin="0,0,0,20"/>
        <RadioButton x:Name="HostRadio" Content="Host (I'm running the game)" IsChecked="True" Margin="0,0,0,8"/>
        <RadioButton x:Name="GuestRadio" Content="Guest (I'll take the stick when passed)" Margin="0,0,0,20"/>
        <Button Content="Start" Click="StartButton_Click" Width="120" HorizontalAlignment="Left"/>
    </StackPanel>
</Window>
