<Window x:Class="PassTheStick.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassTheStick"
        Icon="passthestick.ico"
        Height="360" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource PtsBrushBgPrimary}" CornerRadius="12" BorderBrush="{StaticResource PtsBrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{StaticResource PtsBrushBgSecondary}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Width="16" Height="16" Source="passthestick.ico" Margin="16,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="PassTheStick" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Grid.Column="2" Content="✕" Width="40" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" Click="CloseButton_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Choose your mode" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource PtsBrushTextSecondary}"
                           TextWrapping="Wrap"
                           Text="Host runs the game and shares their screen. Guest joins and controls when passed the stick."/>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="HostCard"
                            Grid.Column="0"
                            Background="{StaticResource PtsBrushBgSecondary}"
                            BorderBrush="{StaticResource PtsBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            MouseLeftButtonUp="HostCard_Click">
                        <StackPanel>
                            <TextBlock Text="Host" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource PtsBrushTextSecondary}" TextWrapping="Wrap"
                                       Text="I’m running the game on this PC. I’ll pin the game window and pass the stick."/>
                            <TextBlock Margin="0,16,0,0" Foreground="{StaticResource PtsBrushTextSecondary}" TextWrapping="Wrap"
                                       Text="Hotkeys: Ctrl+Shift+→ pass, Ctrl+Shift+← take back"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="GuestCard"
                            Grid.Column="2"
                            Background="{StaticResource PtsBrushBgSecondary}"
                            BorderBrush="{StaticResource PtsBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            MouseLeftButtonUp="GuestCard_Click">
                        <StackPanel>
                            <TextBlock Text="Guest" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource PtsBrushTextSecondary}" TextWrapping="Wrap"
                                       Text="I’m joining a friend. I’ll enter the room code and control when it’s my turn."/>
                            <TextBlock Margin="0,16,0,0" Foreground="{StaticResource PtsBrushTextSecondary}" TextWrapping="Wrap"
                                       Text="Tip: keep the Guest window visible so you know when you have the stick."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource PtsBrushBgSecondary}" Padding="16">
                <DockPanel>
                    <TextBlock x:Name="ModeHintText" Foreground="{StaticResource PtsBrushTextSecondary}" VerticalAlignment="Center" Text="Selected: Host"/>
                    <Button x:Name="ContinueButton"
                            DockPanel.Dock="Right"
                            Content="Continue →"
                            Padding="16,8"
                            Background="{StaticResource PtsBrushGreen}"
                            Foreground="#0F0F0F"
                            Click="StartButton_Click"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
