<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\passthestick.ico</ApplicationIcon>
    <AssemblyName>PassTheStick</AssemblyName>
    <RootNamespace>PassTheStick.Launcher</RootNamespace>
    <Version>0.1.19</Version>
    <AssemblyVersion>0.1.19.0</AssemblyVersion>
    <FileVersion>0.1.19.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\passthestick.ico" Link="passthestick.ico" />
  </ItemGroup>

</Project>
