<Window x:Class="PassTheStick.Shared.RelayConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassTheStick"
        Width="620" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Connecting to relay server…"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="{Binding StatusText, Mode=OneWay}"
                   FontSize="13" Foreground="#333" Margin="0,0,0,10"/>

        <Border Grid.Row="2" Background="#F6F6F6" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Relay URL:" Foreground="#666" FontSize="12" Margin="0,0,0,4"/>
                <DockPanel>
                    <TextBox x:Name="RelayUrlBox" Text="{Binding RelayUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="26" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Save" Width="80" Click="SaveUrl_Click" IsEnabled="{Binding CanClickButtons, Mode=OneWay}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#0D0D0D" CornerRadius="6" Padding="8" Margin="0,0,0,12">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     Background="#0D0D0D"
                     Foreground="#DDD"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy logs" Width="110" Margin="0,0,8,0" Click="CopyLogs_Click"/>
            <Expander Header="Advanced" Margin="0,0,8,0" IsExpanded="False" VerticalAlignment="Center"
                      Visibility="{Binding ShowAdvanced, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="If the cloud relay is waking up, it can take 30–60 seconds. Keep retrying first."
                               Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Start local relay server" Width="160"
                            Click="StartRelay_Click" IsEnabled="{Binding CanClickButtons, Mode=OneWay}"/>
                </StackPanel>
            </Expander>
            <Button Content="Retry" Width="90" Margin="0,0,8,0" Click="Retry_Click" IsEnabled="{Binding CanClickButtons, Mode=OneWay}"/>
            <Button Content="Close" Width="90" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>

