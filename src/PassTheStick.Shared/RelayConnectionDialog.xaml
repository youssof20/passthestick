<Window x:Class="PassTheStick.Shared.RelayConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relay connection"
        Width="620"
        Height="420"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PassTheStick.Shared;component/Themes/PtsDialogBrushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <Style x:Key="DlgCloseButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#C0C0C0"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="DlgSecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="#252525"/>
                <Setter Property="BorderBrush" Value="{StaticResource PtsDlgBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource PtsDlgText}"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource PtsDlgText}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource PtsDlgBg}"
            BorderBrush="{StaticResource PtsDlgBorder}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0"
                  Background="{StaticResource PtsDlgTitleBar}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="&#x1F310;"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Relay connection"
                               Foreground="{StaticResource PtsDlgText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource DlgCloseButton}"
                        Content="&#x2715;"
                        Click="Close_Click"
                        ToolTip="Close"/>
            </Grid>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Connecting to relay server…"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PtsDlgText}"
                           Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding StatusText, Mode=OneWay}"
                           FontSize="13"
                           Foreground="{StaticResource PtsDlgMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Border Grid.Row="2"
                        Background="{StaticResource PtsDlgCard}"
                        BorderBrush="{StaticResource PtsDlgBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="RELAY URL"
                                   Foreground="{StaticResource PtsDlgSubtle}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <DockPanel>
                            <TextBox x:Name="RelayUrlBox"
                                     Text="{Binding RelayUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0"
                                     Background="#252525"
                                     BorderBrush="{StaticResource PtsDlgBorder}"
                                     Foreground="{StaticResource PtsDlgText}"
                                     CaretBrush="{StaticResource PtsDlgText}"
                                     BorderThickness="1"
                                     Padding="8,4"/>
                            <Button Content="Save"
                                    Width="80"
                                    Height="30"
                                    Click="SaveUrl_Click"
                                    IsEnabled="{Binding CanClickButtons, Mode=OneWay}"
                                    Background="{StaticResource PtsDlgGreen}"
                                    Foreground="#0F0F0F"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3"
                        Background="{StaticResource PtsDlgLogBg}"
                        BorderBrush="{StaticResource PtsDlgBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Margin="0,0,0,12">
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             Background="Transparent"
                             Foreground="{StaticResource PtsDlgLogFg}"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy logs"
                            Width="110"
                            Margin="0,0,8,0"
                            Click="CopyLogs_Click"
                            Style="{StaticResource DlgSecondaryButton}"/>
                    <Expander Margin="0,0,8,0"
                              IsExpanded="False"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowAdvanced, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Expander.Header>
                            <TextBlock Text="Advanced"
                                       Foreground="{StaticResource PtsDlgMuted}"
                                       FontSize="12"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="If the cloud relay is waking up, it can take 30–60 seconds. Keep retrying first."
                                       Foreground="{StaticResource PtsDlgMuted}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <Button Content="Start local relay server"
                                    Width="180"
                                    Click="StartRelay_Click"
                                    IsEnabled="{Binding CanClickButtons, Mode=OneWay}"
                                    Style="{StaticResource DlgSecondaryButton}"/>
                        </StackPanel>
                    </Expander>
                    <Button Content="Retry"
                            Width="90"
                            Margin="0,0,8,0"
                            Click="Retry_Click"
                            IsEnabled="{Binding CanClickButtons, Mode=OneWay}"
                            Style="{StaticResource DlgSecondaryButton}"/>
                    <Button Content="Close"
                            Width="90"
                            Click="Close_Click"
                            Style="{StaticResource DlgSecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
