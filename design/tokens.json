{
  "$comment": "Single source of design tokens. Edit here, run `node scripts/gen-design.mjs`. Never hard-code values in the app or site.",
  "color": {
    "light": {
      "bg":            "#E8E6DF",
      "surface":       "#F6F5F1",
      "surfaceRaised": "#FFFFFF",
      "border":        "#7A786F",
      "borderSubtle":  "#CBC8BE",
      "text":          "#16181A",
      "textMuted":     "#4B4E52",
      "accent":        "#F2B705",
      "onAccent":      "#16181A",
      "accentText":    "#7A5A00",
      "live":          "#0B6B58",
      "onLive":        "#FFFFFF",
      "danger":        "#B3261E",
      "onDanger":      "#FFFFFF",
      "focus":         "#16181A"
    },
    "dark": {
      "bg":            "#14161A",
      "surface":       "#1E2126",
      "surfaceRaised": "#272B31",
      "border":        "#7B8088",
      "borderSubtle":  "#383D45",
      "text":          "#F1EFE8",
      "textMuted":     "#B4B8BE",
      "accent":        "#F5C518",
      "onAccent":      "#16181A",
      "accentText":    "#F5C518",
      "live":          "#3DD6B0",
      "onLive":        "#0B1A16",
      "danger":        "#FF8A80",
      "onDanger":      "#2A0A07",
      "focus":         "#F1EFE8"
    }
  },
  "contrast": {
    "$comment": "[foreground, background, minimum ratio]. WCAG AA: 4.5 text, 3 for UI boundaries and large text.",
    "pairs": [
      ["text", "bg", 4.5], ["text", "surface", 4.5], ["text", "surfaceRaised", 4.5],
      ["textMuted", "bg", 4.5], ["textMuted", "surface", 4.5], ["textMuted", "surfaceRaised", 4.5],
      ["onAccent", "accent", 4.5], ["onLive", "live", 4.5], ["onDanger", "danger", 4.5],
      ["accentText", "bg", 4.5], ["accentText", "surface", 4.5],
      ["live", "bg", 3], ["live", "surface", 3],
      ["danger", "bg", 3], ["danger", "surface", 3],
      ["border", "bg", 3], ["border", "surface", 3],
      ["focus", "bg", 3], ["focus", "surface", 3]
    ]
  },
  "font": {
    "display": { "family": "Familjen Grotesk", "fallback": "Segoe UI Variable Display, Segoe UI, system-ui, sans-serif" },
    "ui":      { "family": "Atkinson Hyperlegible Next", "fallback": "Segoe UI Variable Text, Segoe UI, system-ui, sans-serif" },
    "code":    { "family": "JetBrains Mono", "fallback": "Cascadia Mono, Consolas, ui-monospace, monospace" },
    "icons":   { "family": "Segoe Fluent Icons", "fallback": "Segoe MDL2 Assets" }
  },
  "type": {
    "caption": { "size": 13, "lineHeight": 1.4,  "weight": 400, "font": "ui" },
    "body":    { "size": 16, "lineHeight": 1.5,  "weight": 400, "font": "ui" },
    "label":   { "size": 14, "lineHeight": 1.3,  "weight": 600, "font": "ui" },
    "title":   { "size": 22, "lineHeight": 1.25, "weight": 600, "font": "display" },
    "heading": { "size": 32, "lineHeight": 1.15, "weight": 700, "font": "display" },
    "display": { "size": 56, "lineHeight": 1.02, "weight": 700, "font": "display" },
    "roomCode":{ "size": 72, "lineHeight": 1.0,  "weight": 700, "font": "code" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 72 },
  "radius": { "control": 4, "panel": 12, "chip": 16, "round": 20, "pill": 999 },
  "motion": {
    "instant": 90, "quick": 160, "handoff": 280,
    "easing": { "out": "0.2, 0.8, 0.2, 1", "inOut": "0.4, 0, 0.2, 1" }
  },
  "focusRing": { "width": 3, "offset": 2 }
}
