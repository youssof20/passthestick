<Window x:Class="PassTheStick.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PtsWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        SizeToContent="WidthAndHeight" Title="PassTheStick overlay">
  <Border x:Name="Pill" Background="{DynamicResource PtsSurfaceRaisedBrush}" BorderBrush="{DynamicResource PtsBorderBrush}"
          BorderThickness="2" CornerRadius="{StaticResource PtsRadiusPanel}" Padding="{StaticResource PtsSpace3Thickness}"
          RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform>
      <TranslateTransform x:Name="Slide"/>
    </Border.RenderTransform>
    <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="Ball" Width="20" Height="20" Fill="{DynamicResource PtsAccentBrush}" Margin="{StaticResource PtsSpace3Right}"/>
      <TextBlock x:Name="Label" VerticalAlignment="Center" FontWeight="SemiBold"/>
    </StackPanel>
  </Border>
</Window>
