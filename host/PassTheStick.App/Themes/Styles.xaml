<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Every color, radius, size and font below comes from the generated token dictionaries. -->

  <Style x:Key="PtsFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" StrokeThickness="3" Stroke="{DynamicResource PtsFocusBrush}" RadiusX="6" RadiusY="6"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Implicit styles do not reach classes derived from Window, so windows opt in with Style="{StaticResource PtsWindow}". -->
  <Style x:Key="PtsWindow" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource PtsBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource PtsFontUi}"/>
    <Setter Property="FontSize" Value="{StaticResource PtsTypeBodySize}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="PtsMuted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource PtsTextMutedBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource PtsTypeCaptionSize}"/>
  </Style>

  <Style x:Key="PtsHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource PtsFontDisplay}"/>
    <Setter Property="FontSize" Value="{StaticResource PtsTypeTitleSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="PtsRoomCode" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource PtsFontCode}"/>
    <Setter Property="FontSize" Value="{StaticResource PtsTypeRoomCodeSize}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource PtsFocusVisual}"/>
    <Setter Property="Foreground" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="{StaticResource PtsInsetControl}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource PtsRadiusControl}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PtsBorderSubtleBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PtsPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource PtsAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PtsOnAccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsOnAccentBrush}"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="{StaticResource PtsSpace3Thickness}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource PtsRadiusControl}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PtsFocusBrush}"/>
              <Setter TargetName="Chrome" Property="BorderThickness" Value="3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource PtsFocusVisual}"/>
    <Setter Property="Padding" Value="{StaticResource PtsSpace3Thickness}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid x:Name="Row" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle x:Name="Bar" Fill="{DynamicResource PtsAccentBrush}" Visibility="Hidden"/>
            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource PtsBorderSubtleBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource PtsSurfaceRaisedBrush}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PtsMeter" TargetType="ProgressBar">
    <Setter Property="Minimum" Value="0"/>
    <Setter Property="Maximum" Value="1"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{DynamicResource PtsBorderSubtleBrush}" CornerRadius="{StaticResource PtsRadiusControl}"/>
            <Border x:Name="PART_Track">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource PtsAccentBrush}" CornerRadius="{StaticResource PtsRadiusControl}"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PtsChip" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource PtsSpace2Thickness}"/>
    <Setter Property="Margin" Value="{StaticResource PtsSpace1Thickness}"/>
    <Setter Property="MinWidth" Value="44"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusControl}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceBrush}"/>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource PtsFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="22" Height="22" Margin="{StaticResource PtsSpace3Right}">
              <Ellipse Stroke="{DynamicResource PtsBorderBrush}" StrokeThickness="2" Fill="{DynamicResource PtsSurfaceRaisedBrush}"/>
              <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource PtsAccentBrush}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Layout building blocks. Everything draws from tokens: no gradients, no glow, accent only for the stick and the main action. -->
  <Style x:Key="PtsDisplay" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource PtsFontDisplay}"/>
    <Setter Property="FontSize" Value="{StaticResource PtsTypeHeadingSize}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style x:Key="PtsLead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource PtsTextMutedBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource PtsTypeBodySize}"/>
  </Style>

  <Style x:Key="PtsCardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource PtsFontDisplay}"/>
    <Setter Property="FontSize" Value="{StaticResource PtsTypeTitleSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="PtsIcon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource PtsFontIcons}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="PtsCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusPanel}"/>
    <Setter Property="Padding" Value="{StaticResource PtsSpace5Thickness}"/>
  </Style>

  <Style x:Key="PtsStep" TargetType="Border">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusChip}"/>
    <Setter Property="Background" Value="{DynamicResource PtsAccentBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PtsOnAccentBrush}"/>
    <Setter Property="Margin" Value="{StaticResource PtsSpace3Right}"/>
  </Style>

  <Style x:Key="PtsStatusPill" TargetType="Border">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusChip}"/>
    <Setter Property="Padding" Value="{StaticResource PtsInsetPill}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceRaisedBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PtsTextMutedBrush}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Phase}" Value="Live">
        <Setter Property="Background" Value="{DynamicResource PtsLiveBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PtsLiveBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PtsOnLiveBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Phase}" Value="Reconnecting">
        <Setter Property="Background" Value="{DynamicResource PtsAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PtsAccentBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PtsOnAccentBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Phase}" Value="Failed">
        <Setter Property="Background" Value="{DynamicResource PtsDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PtsDangerBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PtsOnDangerBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PtsNotice" TargetType="Border">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusPanel}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasNotice}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding HasNotice}" Value="True"/>
          <Condition Binding="{Binding NoticeIsProblem}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource PtsDangerBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PtsWarning" TargetType="Border">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsDangerBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusPanel}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding GameWarningVisible}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PtsRow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PtsBgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderSubtleBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusPanel}"/>
  </Style>

  <Style x:Key="PtsAvatar" TargetType="Border">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusRound}"/>
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style x:Key="PtsHolderTag" TargetType="Border">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusChip}"/>
    <Setter Property="Padding" Value="{StaticResource PtsInsetPill}"/>
    <Setter Property="Background" Value="{DynamicResource PtsAccentBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PtsOnAccentBrush}"/>
  </Style>

  <Style x:Key="PtsKeycap" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PtsSurfaceRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PtsBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,1,1,3"/>
    <Setter Property="CornerRadius" Value="{StaticResource PtsRadiusControl}"/>
    <Setter Property="Padding" Value="{StaticResource PtsInsetKeycap}"/>
    <Setter Property="Margin" Value="{StaticResource PtsSpace1Thickness}"/>
    <Setter Property="TextElement.FontFamily" Value="{StaticResource PtsFontCode}"/>
    <Setter Property="TextElement.FontSize" Value="{StaticResource PtsTypeCaptionSize}"/>
  </Style>

  <Style x:Key="PtsIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontFamily" Value="{StaticResource PtsFontIcons}"/>
    <Setter Property="MinWidth" Value="40"/>
    <Setter Property="Padding" Value="{StaticResource PtsSpace2Thickness}"/>
  </Style>

  <Style x:Key="PtsDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="BorderBrush" Value="{DynamicResource PtsDangerBrush}"/>
  </Style>

  <Style x:Key="PtsSegment" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="{StaticResource PtsInsetControl}"/>
    <Setter Property="Margin" Value="{StaticResource PtsSpace1Right}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="Background" Value="{DynamicResource PtsAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PtsOnAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PtsOnAccentBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PtsBareTextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="PtsExpander" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource PtsTextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="Header" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" FocusVisualStyle="{StaticResource PtsFocusVisual}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock x:Name="Chevron" Style="{StaticResource PtsIcon}" Text="&#xE76C;" Margin="{StaticResource PtsSpace2Right}" Foreground="{DynamicResource PtsTextMutedBrush}"/>
                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{DynamicResource PtsTextMutedBrush}"/>
                  </StackPanel>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter ContentSource="Header"/>
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin tokenized scrollbars instead of the white system ones. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource PtsBorderBrush}" CornerRadius="{StaticResource PtsRadiusControl}" Margin="2,0"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
