<Window x:Class="PassTheStick.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PassTheStick.App.ViewModels"
        xmlns:wn="clr-namespace:PassTheStick.Windows;assembly=PassTheStick.Windows"
        Style="{StaticResource PtsWindow}" Title="PassTheStick" Width="920" Height="680" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="{StaticResource PtsSpace5Thickness}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="320"/>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition Width="*" MinWidth="320"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Notice bar: one place for anything the person needs to read or do. -->
    <Border Grid.ColumnSpan="3" Margin="{StaticResource PtsSpace4Bottom}" Padding="{StaticResource PtsSpace3Thickness}" CornerRadius="{StaticResource PtsRadiusPanel}"
            Background="{DynamicResource PtsSurfaceRaisedBrush}" BorderBrush="{DynamicResource PtsBorderBrush}" BorderThickness="2">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasNotice}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding Notice}" AutomationProperties.LiveSetting="Polite"/>
    </Border>

    <!-- Left: the session. -->
    <StackPanel Grid.Row="1" Grid.Column="0">
      <TextBlock Style="{StaticResource PtsHeading}" Text="Session"/>
      <TextBlock Style="{StaticResource PtsMuted}" Text="{Binding PhaseText}" Margin="{StaticResource PtsSpace4Bottom}"/>

      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsIdle}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="Server address" FontWeight="SemiBold"/>
        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource PtsSpace4Bottom}" AutomationProperties.Name="Server address"/>
        <Button Style="{StaticResource PtsPrimaryButton}" Content="Start a session" Command="{Binding StartCommand}"/>
      </StackPanel>

      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLive}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Style="{StaticResource PtsMuted}" Text="Room code"/>
        <TextBlock Style="{StaticResource PtsRoomCode}" Text="{Binding RoomCode}" AutomationProperties.Name="Room code"/>
        <TextBlock Style="{StaticResource PtsMuted}" Text="{Binding InviteLink}" Margin="{StaticResource PtsSpace3Bottom}" TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PtsPrimaryButton}" Content="Copy invite link" Command="{Binding CopyInviteCommand}" Margin="{StaticResource PtsSpace3Right}"/>
          <Button Content="End session" Command="{Binding EndCommand}"/>
        </StackPanel>
      </StackPanel>

      <!-- Input test: what a guest in test mode is sending, as the host receives it. -->
      <Border Margin="{StaticResource PtsSpace5Top}" Padding="{StaticResource PtsSpace3Thickness}" CornerRadius="{StaticResource PtsRadiusPanel}"
              BorderThickness="2" BorderBrush="{DynamicResource PtsBorderBrush}" Background="{DynamicResource PtsSurfaceBrush}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Probe.IsActive}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Style="{StaticResource PtsHeading}" Text="{Binding Probe.Title}"/>
          <TextBlock Style="{StaticResource PtsMuted}" Text="Nothing here reaches the game." Margin="{StaticResource PtsSpace2Bottom}"/>
          <ItemsControl ItemsSource="{Binding Probe.Buttons}" AutomationProperties.Name="Buttons the guest is pressing">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ButtonChip}">
                <Border x:Name="Chip" Style="{StaticResource PtsChip}">
                  <TextBlock x:Name="Label" Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center"/>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsDown}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PtsAccentBrush}"/>
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource PtsOnAccentBrush}"/>
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PtsOnAccentBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Left stick" Style="{StaticResource PtsMuted}" Margin="{StaticResource PtsSpace2Top}"/>
          <ProgressBar Style="{StaticResource PtsMeter}" Value="{Binding Probe.LeftX}" AutomationProperties.Name="Left stick horizontal"/>
          <ProgressBar Style="{StaticResource PtsMeter}" Value="{Binding Probe.LeftY}" Margin="{StaticResource PtsSpace1Top}" AutomationProperties.Name="Left stick vertical"/>
          <TextBlock Text="Right stick" Style="{StaticResource PtsMuted}" Margin="{StaticResource PtsSpace2Top}"/>
          <ProgressBar Style="{StaticResource PtsMeter}" Value="{Binding Probe.RightX}" AutomationProperties.Name="Right stick horizontal"/>
          <ProgressBar Style="{StaticResource PtsMeter}" Value="{Binding Probe.RightY}" Margin="{StaticResource PtsSpace1Top}" AutomationProperties.Name="Right stick vertical"/>
          <TextBlock Text="Triggers" Style="{StaticResource PtsMuted}" Margin="{StaticResource PtsSpace2Top}"/>
          <ProgressBar Style="{StaticResource PtsMeter}" Value="{Binding Probe.LeftTrigger}" AutomationProperties.Name="Left trigger"/>
          <ProgressBar Style="{StaticResource PtsMeter}" Value="{Binding Probe.RightTrigger}" Margin="{StaticResource PtsSpace1Top}" AutomationProperties.Name="Right trigger"/>
          <TextBlock Text="{Binding Probe.KeysText}" Margin="{StaticResource PtsSpace2Top}"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Right: the game, then the players. -->
    <Grid Grid.Row="1" Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Style="{StaticResource PtsHeading}" Text="Game window"/>
        <TextBlock Style="{StaticResource PtsMuted}" Text="{Binding GameText}" Margin="{StaticResource PtsSpace2Bottom}"/>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" MinHeight="96"
               AutomationProperties.Name="Open windows">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type wn:WindowInfo}">
            <StackPanel>
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ProcessName}" Style="{StaticResource PtsMuted}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="{StaticResource PtsSpace4Bottom}">
        <Button Content="Use this window" Command="{Binding PinCommand}" Margin="{StaticResource PtsSpace3Right}"/>
        <Button Content="Refresh list" Command="{Binding RefreshWindowsCommand}"/>
      </StackPanel>

      <Grid Grid.Row="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource PtsHeading}" Text="Players"/>
          <TextBlock Style="{StaticResource PtsMuted}" Text="{Binding HolderText}"/>
          <TextBlock Style="{StaticResource PtsMuted}" Margin="{StaticResource PtsSpace2Bottom}">
            <Run Text="Hotkeys: "/><Run Text="{Binding PassHotkeyText, Mode=OneWay}"/><Run Text=" passes. "/><Run Text="{Binding TakeBackHotkeyText, Mode=OneWay}"/><Run Text=" takes it back."/>
          </TextBlock>
        </StackPanel>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Players}" AutomationProperties.Name="Players">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
              <Border Margin="{StaticResource PtsSpace2Bottom}" Padding="{StaticResource PtsSpace3Thickness}" CornerRadius="{StaticResource PtsRadiusPanel}" BorderThickness="2"
                      BorderBrush="{DynamicResource PtsBorderSubtleBrush}" Background="{DynamicResource PtsSurfaceBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource PtsMuted}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Pass the stick" Command="{Binding PassCommand}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="{StaticResource PtsSpace2Top}">
          <Button Style="{StaticResource PtsPrimaryButton}" Content="Pass to next" Command="{Binding PassNextCommand}" Margin="{StaticResource PtsSpace3Right}"/>
          <Button Content="Take the stick back" Command="{Binding TakeBackCommand}"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- First-run wizard, shown over everything until it is finished or skipped. -->
    <Border Grid.RowSpan="2" Grid.ColumnSpan="3" Background="{DynamicResource PtsBgBrush}" Padding="{StaticResource PtsSpace5Thickness}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding ShowWizard}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid DataContext="{Binding Wizard}" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsWelcome}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource PtsHeading}" Text="Welcome to PassTheStick" Margin="{StaticResource PtsSpace3Bottom}"/>
            <TextBlock Text="You run the game. Your friends send their keyboard, controller or phone to it from a link, and everyone watches your Discord screen share. Nobody else installs anything." Margin="{StaticResource PtsSpace3Bottom}"/>
            <TextBlock Style="{StaticResource PtsMuted}" Text="Setup takes about a minute. You can skip it and change any of this later."/>
          </StackPanel>
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsGame}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource PtsHeading}" Text="Which window is the game?" Margin="{StaticResource PtsSpace3Bottom}"/>
            <TextBlock Style="{StaticResource PtsMuted}" Text="Open the game first, then pick its window. Input only goes to this window." Margin="{StaticResource PtsSpace2Bottom}"/>
            <ListBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" Height="200" AutomationProperties.Name="Open windows">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type wn:WindowInfo}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ProcessName}" Style="{StaticResource PtsMuted}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="{StaticResource PtsSpace3Top}">
              <Button Content="Use this window" Command="{Binding PickCommand}" Margin="{StaticResource PtsSpace3Right}"/>
              <Button Content="Refresh list" Command="{Binding RefreshWindowsCommand}"/>
            </StackPanel>
            <TextBlock Margin="{StaticResource PtsSpace3Top}"><Run Text="Picked: "/><Run Text="{Binding PickedTitle, Mode=OneWay, FallbackValue=nothing yet}" FontWeight="SemiBold"/></TextBlock>
            <TextBlock Foreground="{DynamicResource PtsDangerBrush}" Text="{Binding Error}"/>
          </StackPanel>
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsControls}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource PtsHeading}" Text="What will your friends use?" Margin="{StaticResource PtsSpace3Bottom}"/>
            <RadioButton GroupName="controls" Content="Keyboard only" IsChecked="True" Margin="{StaticResource PtsSpace2Bottom}"/>
            <RadioButton GroupName="controls" Content="Controllers too" IsChecked="{Binding WantsControllers}" Margin="{StaticResource PtsSpace3Bottom}"/>
            <TextBlock Text="{Binding DriverMessage}" Margin="{StaticResource PtsSpace2Bottom}"/>
            <Button Content="Check again" Command="{Binding CheckDriverCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource PtsHeading}" Text="You are set" Margin="{StaticResource PtsSpace3Bottom}"/>
            <TextBlock Text="Press Start a session, then copy the invite link into Discord. Your friends click it and they are in." Margin="{StaticResource PtsSpace3Bottom}"/>
            <TextBlock Style="{StaticResource PtsMuted}" Text="While you play, the hotkeys and the tray icon pass the stick without leaving the game."/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="{StaticResource PtsSpace5Top}">
            <Button Content="Back" Command="{Binding BackCommand}" Margin="{StaticResource PtsSpace3Right}"/>
            <Button Style="{StaticResource PtsPrimaryButton}" Content="{Binding NextText}" Command="{Binding NextCommand}" Margin="{StaticResource PtsSpace3Right}"/>
            <Button Content="Skip setup" Command="{Binding SkipCommand}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
